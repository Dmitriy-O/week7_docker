fields requestReceivedTimestamp as time,
       user.username as actor,
       verb,
       objectRef.name as secretName,
       responseStatus.code as code
| filter @logStream like /kube-apiserver-audit/
| filter stage = "ResponseComplete"
| filter objectRef.namespace = "healthchecks"
| filter objectRef.resource = "secrets" and responseStatus.code = 403
| sort @timestamp desc
| limit 10
