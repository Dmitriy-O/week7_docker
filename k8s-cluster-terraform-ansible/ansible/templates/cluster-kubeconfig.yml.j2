apiVersion: v1
kind: Config
clusters:
  - name: week10
    cluster:
      server: {{ (pki_api_endpoint_external if identity.kubeconfig == 'external' else pki_api_endpoint_internal) | to_json }}
      certificate-authority-data: {{ lookup('ansible.builtin.file', pki_dir ~ '/ca.crt', rstrip=false) | b64encode | to_json }}
users:
  - name: {{ identity.name | to_json }}
    user:
      client-certificate-data: {{ lookup('ansible.builtin.file', pki_dir ~ '/' ~ identity.name ~ '.crt', rstrip=false) | b64encode | to_json }}
      client-key-data: {{ lookup('ansible.builtin.file', pki_dir ~ '/' ~ identity.name ~ '.key', rstrip=false) | b64encode | to_json }}
contexts:
  - name: {{ identity.name | to_json }}
    context:
      cluster: week10
      user: {{ identity.name | to_json }}
current-context: {{ identity.name | to_json }}
